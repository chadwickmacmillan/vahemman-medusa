    "@medusajs/dashboard": "^2.18.0",
    "@medusajs/draft-order": "^2.18.0",
    "@medusajs/framework": "2.18.0",
    "@medusajs/icons": "^2.18.0",
    "@medusajs/js-sdk": "^2.18.0",
    "@medusajs/medusa": "2.18.0",
    "@medusajs/medusa-js": "^6.1.10",
    "@medusajs/types": "^2.18.0",
    "@medusajs/ui": "^4.1.12",
    "@medusajs/ui-preset": "^2.18.0",
    "@react-email/components": "^1.0.12",
    "@sanity/client": "^7.22.0",
    "radix-ui": "^1.5.0",
    "react-aria": "^3.48.0",
    "react-aria-components": "^1.17.0",
    "react-email": "^6.1.4",
    "react-hook-form": "^7.75.0",
    "resend": "^6.12.3",
    "sanity": "^5.25.1",
    "shipstation-node": "^2.2.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "taxjar": "^4.1.0"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.18.0",
    "@swc/core": "1.15.33",
